[Unit]
Description=expertpin dev-serving: qwen3.8-flash-next (UD-Q4_K_XL default) for Hermes
# Resident OpenAI-compatible endpoint on 127.0.0.1:8102/v1.
# ALWAYS STARTED MANUALLY (never `systemctl --user enable` this unit):
#   systemctl --user start expertpin-dev.service
#   systemctl --user stop  expertpin-dev.service
# Miner policy (Seppe, 2026-09-11): this unit NEVER stops or starts a miner.
# qli.service is masked/paused — never start or restart it. Jetski keeps
# running during the day; the launcher's own Tier A guard then correctly
# refuses to start. To serve while Jetski runs, stop it manually first and
# restart it manually afterwards (night-cron harnesses do this themselves).

[Service]
Type=simple
WorkingDirectory=%h/Projects/expertpin
ExecStart=%h/Projects/expertpin/scripts/serve-dev-qwen38.sh
# Full trained window (>=250K, Seppe 2026-09-14): KV at q4_0 keeps the 262144
# context within the 28 GiB VRAM budget at NCMOE 40 (measured 64K peak was
# 24.05 GiB with q8_0 KV; q4_0 at 262144 lands lower). Needle-recall at 250K
# on UD with q4 KV is NOT yet verified — context CAPACITY only.
Environment=CTX=262144
Environment=KVT=q4_0
# MTP drafter on (Qwen4Exp MTP I/O preservation fixed in c821c8d2): ~2x decode,
# target-side acceptance keeps output quality. Dev sessions stay prefill-bound.
Environment=DRAFT=1
Environment=PORT=8102
# Measurement mode (2026-09-15 residency slice): advisory per-expert access
# histogram (GGML_MOE_HISTOGRAM lane) + engine-stats dump at teardown, written
# to EXPERT_STATS_FILE. Back out both lines once the residency manifest lands.
Environment=GGML_MOE_HISTOGRAM=1
Environment=EXPERT_STATS_FILE=%h/Projects/expertpin/.hermes-work/residency-20260915/expert-stats.json
MemoryHigh=33G
MemoryMax=36G
MemorySwapMax=16G
Restart=on-failure
RestartSec=30
# The launcher's own guards refuse to start while the host is too busy;
# on-failure restart then retries until the host frees up.

[Install]
WantedBy=default.target
