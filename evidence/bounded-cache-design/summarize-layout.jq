([.tensors[] | . as $t | ({"20":[32,18],"21":[256,110],"22":[256,82]}[($t.ggml_type|tostring)]) as $q | {name:$t.name,ggml_type:$t.ggml_type,experts:$t.dims[2],slice_bytes:($t.dims[0]/$q[0]*$q[1]*$t.dims[1]),payload_matches_span:($t.dims[0]/$q[0]*$q[1]*$t.dims[1]*$t.dims[2]==$t.storage_span_bytes)}]) as $rows | {basis:"contiguous GGUF payload formula; quant blocks from gguf-py/gguf/constants.py:2206-2208; not a runtime allocation measurement",all_payloads_match_spans:([$rows[].payload_matches_span]|all),total_payload_bytes:([$rows[]|.slice_bytes*.experts]|add),slice_sizes:($rows|group_by(.ggml_type)|map({ggml_type:.[0].ggml_type,tensor_count:length,slice_bytes:.[0].slice_bytes,experts_per_tensor:.[0].experts})),last30_payload_bytes:([$rows[]|select((.name|split(".")[1]|tonumber)>=18)|.slice_bytes*.experts]|add),last30_slices:([$rows[]|select((.name|split(".")[1]|tonumber)>=18)|.experts]|add),iq3_layers:([.tensors[]|select(.ggml_type==21)|(.name|split(".")[1]|tonumber)]|unique)}
